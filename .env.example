# Resend API key — https://resend.com/api-keys
# If empty, contact form submissions are logged to the server console in development.
RESEND_API_KEY=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=hello@maqvoratech.com

# Verified sender for Resend (use onboarding@resend.dev while testing)
CONTACT_FROM_EMAIL="Maqvoratech <onboarding@resend.dev>"

# Public site URL (no trailing slash) — used for canonical URLs, sitemap and OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000
